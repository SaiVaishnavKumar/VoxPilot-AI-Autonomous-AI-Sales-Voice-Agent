# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication (Change in production)
JWT_SECRET=voxpilot-local-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
# Options: auto (tries MongoDB first, falls back to SQLite), mongo, sqlite
DB_MODE=auto
MONGODB_URI=mongodb://127.0.0.1:27017/voxpilot_ai
SQLITE_PATH=./data/voxpilot.db

# Google Gemini AI Configuration
# Obtain a free key from Google AI Studio (https://aistudio.google.com/)
# Required for Gemini AI responses and cloud microphone transcription. Audio clips are sent to Gemini.
# Leave empty to automatically run in Intelligent Demo Fallback Mode (text chat only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Business Profile
COMPANY_NAME=Horizon Crest Realty
DEFAULT_INDUSTRY=real-estate
